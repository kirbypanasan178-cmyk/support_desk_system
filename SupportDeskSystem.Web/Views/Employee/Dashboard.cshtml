@using SupportDeskSystem.Web.Enums
@model IEnumerable<SupportDeskSystem.Web.Models.Ticket>

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid px-4 py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Tickets</h2>
            <p class="text-muted mb-0">
                View and manage your submitted support tickets.
            </p>
        </div>

        <a asp-controller="Employee"
           asp-action="CreateTicket"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Create Ticket
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Tickets</p>
                    <h3 class="fw-bold mb-0">@Model.Count()</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Open</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(t => t.Status == TicketStatus.Open)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">In Progress</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(t => t.Status == TicketStatus.InProgress)
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Resolved</p>
                    <h3 class="fw-bold mb-0">
                        @Model.Count(t => t.Status == TicketStatus.Resolved)
                    </h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Tickets -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold mb-0">My Tickets</h5>
        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-ticket-perforated fs-1 text-muted"></i>

                    <h5 class="mt-3">No tickets yet</h5>

                    <p class="text-muted">
                        You haven't submitted any support tickets.
                    </p>

                    <a asp-controller="Employee"
                       asp-action="CreateTicket"
                       class="btn btn-primary">
                        Create Your First Ticket
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4">#</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end px-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var ticket in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        #@ticket.Id
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @ticket.Title
                                        </div>

                                        @if (!string.IsNullOrEmpty(ticket.Description))
                                        {
                                            <small class="text-muted">
                                                @(ticket.Description.Length > 60
                                                                                    ? ticket.Description.Substring(0, 60) + "..."
                                                                                    : ticket.Description)
                                </small>
                                                                }
                                    </td>

                                    <td>
                                        @ticket.Category
                                    </td>

                                    <td>
                                        @ticket.Priority
                                    </td>

                                    <td>
                                        @switch (ticket.Status)
                                        {
                                            case TicketStatus.Open:
                                                <span class="badge bg-primary">
                                                    Open
                                                </span>
                                                break;

                                            case TicketStatus.InProgress:
                                                <span class="badge bg-warning text-dark">
                                                    In Progress
                                                </span>
                                                break;

                                            case TicketStatus.Resolved:
                                                <span class="badge bg-success">
                                                    Resolved
                                                </span>
                                                break;

                                            case TicketStatus.Closed:
                                                <span class="badge bg-secondary">
                                                    Closed
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @ticket.Status
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @ticket.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>

                                    <td class="text-end px-4">
                                        <a asp-controller="Employee"
                                           asp-action="Details"
                                           asp-route-id="@ticket.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
