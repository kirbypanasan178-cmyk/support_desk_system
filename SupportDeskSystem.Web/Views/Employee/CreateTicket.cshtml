
@using SupportDeskSystem.Web.Enums
@model SupportDeskSystem.Web.Models.Ticket

@{
    ViewData["Title"] = "Create Ticket";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Create Ticket</h2>
        <p class="text-muted mb-0">
            Submit a new support ticket
        </p>
    </div>

    <form asp-controller="Employee"
          asp-action="CreateTicket"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label">
                Title
            </label>

            <input asp-for="Title"
                   class="form-control"
                   placeholder="Enter ticket title" />

            <span asp-validation-for="Title"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="form-control"
                      rows="5"
                      placeholder="Describe your problem">
            </textarea>

            <span asp-validation-for="Description"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">
                Category
            </label>

            <select asp-for="Category"
                    asp-items="Html.GetEnumSelectList<TicketCategory>()"
                    class="form-select">

                <option value="">-- Select Category --</option>

            </select>

            <span asp-validation-for="Category"
                  class="text-danger">
            </span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary">
                Submit Ticket
            </button>

            <a asp-controller="Employee"
               asp-action="Dashboard"
               class="btn btn-secondary">
                Back to Dashboard
            </a>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
