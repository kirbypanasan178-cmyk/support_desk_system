@using SupportDeskSystem.Web.Enums
@model SupportDeskSystem.Web.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container-fluid px-4 py-4">

   
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Ticket Details</h2>
            <p class="text-muted mb-0">
                View complete information about this support ticket
            </p>
        </div>

        <a asp-controller="SupportStaff"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="row g-4">

        <!-- Ticket Information -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <p class="text-muted mb-1">
                                Ticket #@Model.Id
                            </p>

                            <h4 class="fw-bold mb-0">
                                @Model.Title
                            </h4>
                        </div>

                        <div>
                            @if (Model.Status == TicketStatus.Open)
                            {
                                <span class="badge bg-warning text-dark">
                                    Open
                                </span>
                            }
                            else if (Model.Status == TicketStatus.InProgress)
                            {
                                <span class="badge bg-primary">
                                    In Progress
                                </span>
                            }
                            else if (Model.Status == TicketStatus.Resolved)
                            {
                                <span class="badge bg-success">
                                    Resolved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Model.Status
                                </span>
                            }
                        </div>

                    </div>
                </div>

                <div class="card-body px-4 pb-4">

                    <!-- Description -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2">Description</h6>

                        <div class="bg-light rounded p-3">
                            @Model.Description
                        </div>
                    </div>

                    <!-- Ticket Information -->
                    <div class="row g-3">

                        <div class="col-md-4">
                            <small class="text-muted d-block">
                                Category
                            </small>

                            <span class="fw-semibold">
                                @Model.Category
                            </span>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted d-block">
                                Priority
                            </small>

                            <span class="fw-semibold">
                                @Model.Priority
                            </span>
                        </div>

                        <div class="col-md-4">
                            <small class="text-muted d-block">
                                Status
                            </small>

                            <span class="fw-semibold">
                                @Model.Status
                            </span>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Created By
                            </small>

                            <span class="fw-semibold">
                                @(Model.CreatedBy?.FullName ?? "Unknown")
                            </span>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">
                                Assigned To
                            </small>

                            <span class="fw-semibold">
                                @(Model.AssignedTo?.FullName ?? "Unassigned")
                            </span>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Comments -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-0">
                        Comments
                    </h5>
                </div>

                <div class="card-body p-4">

                    @if (Model.Comments == null || !Model.Comments.Any())
                    {
                        <div class="text-center py-4">
                            <p class="text-muted mb-0">
                                No comments yet.
                            </p>
                        </div>
                    }
                    else
                    {
                        @foreach (var comment in Model.Comments.OrderBy(c => c.Id))
                        {
                            <div class="border-bottom pb-3 mb-3">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="fw-semibold">
                                        @(comment.User?.FullName ?? "Unknown User")
                                    </span>

                                    <small class="text-muted">
                                        @comment.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")
                                    </small>

                                </div>

                                <p class="mb-0">
                                    @comment.Message
                                </p>

                            </div>
                        }
                    }

                </div>

            </div>

        </div>

        <!-- Actions -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-0">
                        Actions
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="d-grid gap-2">

                        <a asp-controller="SupportStaff"
                           asp-action="EditTicket"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">
                            Edit Ticket
                        </a>

                        <form asp-controller="SupportStaff"
                              asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this ticket?');">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100">
                                Delete Ticket
                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <!-- Ticket Summary -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-0">
                        Ticket Summary
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Ticket ID</span>
                        <span class="fw-semibold">#@Model.Id</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Category</span>
                        <span class="fw-semibold">@Model.Category</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Priority</span>
                        <span class="fw-semibold">@Model.Priority</span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Status</span>
                        <span class="fw-semibold">@Model.Status</span>
                    </div>

                </div>

            </div>

        </div>

    </div>
 

</div>
