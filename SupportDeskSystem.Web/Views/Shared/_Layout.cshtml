@using System.Security.Claims

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Support Desk System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <div class="d-flex">

        <!-- Sidebar -->
        <aside class="bg-dark text-white p-3"
               style="width: 250px; min-height: 100vh;">

            <h4 class="mb-4">Support Desk</h4>

            <ul class="nav flex-column">

                <!-- EMPLOYEE -->
                @if (User.IsInRole("Employee"))
                {
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Employee"
                           asp-action="Dashboard">
                            Dashboard
                        </a>
                    </li>
                }

                <!-- SUPPORT STAFF -->
                @if (User.IsInRole("SupportStaff"))
                {
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="SupportStaff"
                           asp-action="Dashboard">
                            Dashboard
                        </a>
                    </li>
                }

                <!-- ADMIN -->
                @if (User.IsInRole("Admin"))
                {
                    <!-- Users -->
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="User"
                           asp-action="Index">
                            Users
                        </a>
                    </li>

                    <!-- Support Staff -->
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="SupportStaff"
                           asp-action="Dashboard">
                            Support Staff
                        </a>
                    </li>
                }

            </ul>

            <!-- Logout -->
            <form asp-controller="Auth"
                  asp-action="Logout"
                  method="post"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger w-100">
                    Logout
                </button>

            </form>

        </aside>


        <!-- Main Content -->
        <main class="flex-grow-1">

            <!-- Top Navbar -->
            <nav class="navbar navbar-light bg-light border-bottom px-4">

                <span>
                    Welcome, @User.Identity?.Name
                </span>

                <span class="badge bg-secondary">
                    @User.FindFirst(ClaimTypes.Role)?.Value
                </span>

            </nav>


            <!-- Page Content -->
            <div class="container-fluid p-4">

                @RenderBody()

            </div>

        </main>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>